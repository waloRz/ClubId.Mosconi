@using Microsoft.AspNetCore.Mvc.Filters
@using Microsoft.EntityFrameworkCore
@using ClubId.Data
@model ClubId.Models.ViewModels.JugadorPorEquipoViewModel

@{
  ViewData["Title"] = "Editar jugador";
}

@section Styles {
  <link rel="stylesheet" href="~/css/edit-jugador.css" asp-append-version="true" />
}

<div class="edit-page">

  <!-- ── Header ── -->
  <div class="edit-header">
    <div>
      <div class="edit-eyebrow">Gestión de plantel</div>
      <h2 class="edit-title">
        Editando: <span>@Model.Apellido, @Model.Nombre</span>
      </h2>
      <p class="edit-subtitle">N° Carnet: @Model.Idjugador · DNI: @Model.Dni</p>
    </div>
    <a asp-action="Index" class="edit-back">
      <i class="bi bi-arrow-left"></i> Volver al listado
    </a>
  </div>

  <form asp-action="Edit" method="post" enctype="multipart/form-data" id="formEdit">
    <input type="hidden" asp-for="idjugadorxEquipo" />

    <div class="edit-grid">

      <!-- ══ PANEL: Datos personales ══ -->
      <div class="edit-panel personal">
        <div class="edit-panel-head">
          <i class="bi bi-person-badge"></i>
          <span class="edit-panel-head-title">Datos personales</span>
        </div>
        <div class="edit-panel-body">

          <div class="form-row">
            <div class="form-field">
              <label asp-for="Apellido"></label>
              <input asp-for="Apellido" class="form-control" placeholder="Ej: Messi" id="Apellido" />
              <span asp-validation-for="Apellido" class="text-danger"></span>
            </div>
            <div class="form-field">
              <label asp-for="Nombre"></label>
              <input asp-for="Nombre" class="form-control" placeholder="Ej: Lionel" id="Nombre" />
              <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
          </div>

          <div class="char-counter-wrap">
            <span class="char-counter-label">
              <i class="bi bi-card-text"></i> Espacio en carnet (Apellido + Nombre)
            </span>
            <span id="charCount" class="char-counter-value">0 / 26</span>
          </div>
          <span id="charWarning" class="char-warning">
            <i class="bi bi-exclamation-circle me-1"></i>
            Alcanzaste el límite máximo para imprimir el carnet
          </span>

          <div class="form-row">
            <div class="form-field">
              <label asp-for="Dni"></label>
              <div class="input-group-edit">
                <span class="input-group-icon"><i class="bi bi-postcard"></i></span>
                <input asp-for="Dni" class="form-control" id="DniInput"
                       oninput="formatAndValidateDni(this)" maxlength="10" placeholder="XX.XXX.XXX" />
              </div>
              <span asp-validation-for="Dni" class="text-danger"></span>
            </div>
            <div class="form-field">
              <label asp-for="FechaNac">Fecha de nacimiento</label>
              <input asp-for="FechaNac" class="form-control" type="date" />
              <span asp-validation-for="FechaNac" class="text-danger"></span>
            </div>
          </div>

          <!-- Switch de estado con color semántico -->
          <div class="estado-switch-wrap @(Model.Activo ? "is-activo" : "is-inactivo")" id="estadoWrap">
            <input class="form-check-input" type="checkbox" asp-for="Activo"
                   role="switch" id="ActivoSwitch" />
            <div>
              <span class="estado-label-title" id="estadoTitle">
                @(Model.Activo ? "✓ Jugador habilitado" : "✗ Jugador sancionado / inactivo")
              </span>
              <span class="estado-label-sub">
                @(Model.Activo
                  ? "El jugador puede participar en partidos."
                  : "El jugador NO puede participar en partidos.")
              </span>
            </div>
          </div>

        </div>
      </div>

      <!-- ══ PANEL: Afiliación y foto ══ -->
      <div class="edit-panel afiliacion">
        <div class="edit-panel-head">
          <i class="bi bi-trophy"></i>
          <span class="edit-panel-head-title">Afiliación y foto</span>
        </div>
        <div class="edit-panel-body">

          <div class="form-row">
            <div class="form-field">
              <label asp-for="IdCategoria">Categoría</label>
              <select asp-for="IdCategoria" class="form-select" asp-items="@Model.ListaCategoria">
                <option value="">Seleccionar categoría</option>
              </select>
              <span asp-validation-for="IdCategoria" class="text-danger"></span>
            </div>
            <div class="form-field">
              <label asp-for="IdEquipo">Equipo</label>
              <select asp-for="IdEquipo" class="form-select" asp-items="@Model.ListaEquipos">
                <option value="">Seleccionar equipo</option>
              </select>
              <span asp-validation-for="IdEquipo" class="text-danger"></span>
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label asp-for="FechaRecibo">Fecha de inscripción</label>
              <input asp-for="FechaRecibo" class="form-control" type="date" />
              <span asp-validation-for="FechaRecibo" class="text-danger"></span>
            </div>
            <div class="form-field">
              <label asp-for="NroCarnetOld">N° Carnet anterior</label>
              <div class="input-group-edit">
                <span class="input-group-icon"><i class="bi bi-postcard"></i></span>
                <input asp-for="NroCarnetOld" class="form-control" id="NroCarnetOld" />
              </div>
            </div>
          </div>

          <!-- Foto: protagonista -->
          <div class="foto-section">
            <div class="foto-section-label">
              <i class="bi bi-camera-fill"></i> Foto del jugador
            </div>

            <div class="foto-layout">

              <!-- Upload -->
              <div class="foto-upload-wrap">
                <div class="foto-dropzone">
                  <i class="bi bi-cloud-arrow-up foto-dropzone-icon"></i>
                  <span class="foto-dropzone-text">Subir nueva foto</span>
                  <input type="file" name="photo" class="form-control" accept="image/*" />
                  <small>JPG, PNG o JPEG · Reemplaza la foto actual</small>
                </div>
              </div>

              <!-- Vista actual — carnet grande -->
              <div class="foto-preview-wrap">
                <div class="foto-preview-frame">
                  @if (!string.IsNullOrWhiteSpace(Model.Foto))
                  {
                    <img src="~/fotosPerfiles/@Model.Foto" alt="Foto actual del jugador" />
                  }
                  else
                  {
                    <div class="foto-preview-empty">
                      <i class="bi bi-person-bounding-box"></i>
                      <span>Sin foto</span>
                    </div>
                  }
                </div>
                <span class="foto-preview-caption">Foto actual</span>
              </div>

            </div>
          </div>

        </div>
      </div>

    </div><!-- /edit-grid -->

    <!-- ══ ACCIONES ══ -->
    <div class="edit-actions">
      <button type="submit" name="accion" value="guardar" class="btn-edit save">
        <i class="bi bi-floppy"></i> Guardar cambios
      </button>
      <button type="submit" name="accion" value="pase" class="btn-edit pase">
        <i class="bi bi-arrow-left-right"></i> Guardar y realizar pase
      </button>
      <div class="edit-actions-divider"></div>
      <a asp-action="Index" class="btn-edit cancel">
        <i class="bi bi-x"></i> Cancelar
      </a>
    </div>

  </form>
</div>

@section Scripts {
  @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

  <script>
    /* ── DNI format ── */
    function formatAndValidateDni(input) {
      let val = input.value.replace(/\D/g, '');
      let fmt = '';
      if (val.length > 0) fmt += val.substring(0, 2);
      if (val.length > 2) fmt += '.' + val.substring(2, 5);
      if (val.length > 5) fmt += '.' + val.substring(5, 8);
      input.value = fmt.substring(0, 10);
    }

    $(document).ready(function () {

      /* ── Cascada Categoría → Equipo ── */
      const categoriaSelect = $('#IdCategoria');
      const equipoSelect    = $('#IdEquipo');

      categoriaSelect.on('change', function () {
        const id = $(this).val();
        equipoSelect.empty().prop('disabled', true)
          .append('<option value="">Cargando\u2026</option>');
        if (id) {
          $.ajax({
            url:      '@Url.Action("GetEquiposPorCategoria", "Jgrxeqp")',
            type:     'GET',
            data:     { idCategoria: id },
            dataType: 'json',
            success: function (data) {
              equipoSelect.empty().prop('disabled', false)
                .append('<option value="">Seleccionar equipo</option>');
              if (data.length > 0) {
                $.each(data, function (_, eq) {
                  equipoSelect.append('<option value="' + eq.value + '">' + eq.text + '</option>');
                });
              } else {
                equipoSelect.append('<option value="">No hay equipos en esta categoría</option>');
              }
            },
            error: function () {
              equipoSelect.empty().prop('disabled', false)
                .append('<option value="">Error al cargar equipos</option>');
            }
          });
        } else {
          equipoSelect.empty().prop('disabled', false)
            .append('<option value="">Seleccionar equipo</option>');
        }
      });

      $.validator.unobtrusive.parse(document);

      /* ── Switch de estado: visual reactivo ── */
      const $switch = $('#ActivoSwitch');
      const $wrap   = $('#estadoWrap');
      const $title  = $('#estadoTitle');

      function updateEstado(isActivo) {
        $wrap.removeClass('is-activo is-inactivo')
             .addClass(isActivo ? 'is-activo' : 'is-inactivo');
        $title.text(isActivo
          ? '\u2713 Jugador habilitado'
          : '\u2717 Jugador sancionado / inactivo');
      }

      $switch.on('change', function () { updateEstado($(this).is(':checked')); });

      /* ── Contador Apellido + Nombre ── */
      const maxChars = 26;
      const $apellido = $('#Apellido');
      const $nombre   = $('#Nombre');
      const $counter  = $('#charCount');
      const $warning  = $('#charWarning');

      function checkCombinedLength(e) {
        let total = $apellido.val().length + $nombre.val().length;
        if (total > maxChars) {
          const excess = total - maxChars;
          const $cur = $(e.target);
          $cur.val($cur.val().slice(0, -excess));
          total = $apellido.val().length + $nombre.val().length;
          $counter.removeClass('warn').addClass('danger');
          $warning.slideDown(150);
        } else {
          $counter.removeClass('warn danger');
          if (total >= maxChars - 3) $counter.addClass('warn');
          $warning.slideUp(150);
        }
        $counter.text(total + ' / ' + maxChars);
      }

      $apellido.on('input', checkCombinedLength);
      $nombre.on('input', checkCombinedLength);
      checkCombinedLength({ target: $apellido[0] });
    });
  </script>
}
