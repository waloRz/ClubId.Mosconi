@using ClubId.Data
@using Microsoft.AspNetCore.Mvc.Filters
@using Microsoft.EntityFrameworkCore

@model IEnumerable<ClubId.Models.ViewModels.JugadorPorEquipoViewModel>

@{
  ViewData["Title"] = "Jugadores";
}

@section Styles {
    <link rel="stylesheet" href="~/css/jugadores.css" asp-append-version="true" />
}

<div class="jug-page">

   <!-- Hero -->
  <div class="jug-hero">
    <div class="jug-hero-inner">
      <div>
        <div class="jug-hero-eyebrow">Panel de gestión</div>
        <h2 class="jug-hero-title">Plantel <span>Activo</span></h2>
        <p class="jug-hero-meta">Jugadores registrados · Temporada en curso</p>
      </div>
      <img src="~/imgFijas/escudoLiga.png" alt="Escudo de la liga" class="jug-hero-escudo" />
    </div>
  </div>

   <!-- Search + Nuevo jugador -->
  <div class="jug-search-wrap">
    <form method="get" class="d-flex gap-2 align-items-center" style="margin:0; flex:1;">
      <input class="jug-search-input" type="search" name="q"
             value="@(ViewBag.Query ?? "")"
             placeholder="DNI, Nombre o N° Carnet…" />
      <button class="btn-buscar" type="submit">Buscar</button>
    </form>
    <a asp-action="Create" class="btn-nuevo ms-auto">
      <i class="bi bi-plus-lg"></i> Nuevo jugador
    </a>
  </div>

   <!-- Table -->
  <div class="jug-table-wrap">
    <table class="jug-table">
      <thead>
        <tr>
          <th style="width:36%;">Jugadores</th>
          <th style="width:10%;" class="text-center">Estado</th>
          <th style="width:16%;" class="text-center">Equipo / Categoria</th>
          <th style="width:12%;" class="text-center">Fecha Recibo</th>
          <th style="width:26%;" class="text-center">Acciones</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var p in Model)
        {
          <tr class="jug-row @(p.Activo ? "habilitado" : "sancionado")"
              data-href="@Url.Action("Details", new { id = p.Idjugador })">

             <!-- Jugador -->
            <td>
              <div class="d-flex align-items-center gap-3">
                @if (!string.IsNullOrWhiteSpace(p.Foto))
                {
                  <img src="~/fotosPerfiles/@p.Foto" class="jug-avatar" alt="foto" />
                }
                else
                {
                  <div class="jug-avatar-placeholder">
                    <i class="bi bi-person"></i>
                  </div>
                }
                <div>
                  <a asp-action="Details" asp-route-id="@p.Idjugador" class="jug-name">
                    @p.Apellido, @p.Nombre
                  </a>
                  <div class="jug-sub">
                    <span>DNI&nbsp;@p.Dni</span>
                    <span class="jug-carnet-chip">#@p.Idjugador</span>
                  </div>
                </div>
              </div>
            </td>

             <!-- Estado -->
            <td class="text-center">
              @if (p.Activo)
              {
                <span class="status-badge hab">Habilitado</span>
              }
              else
              {
                <span class="status-badge san">Sancionado</span>
              }
            </td>

             <!-- Club / Categoría -->
            <td class="text-center">
              <div>
                <span class="pill-club">@p.NombreEq</span>
              </div>
              <span class="pill-cat">@p.NombreCat</span>
            </td>

             <!-- Fecha -->
            <td class="text-center">
              <span class="fecha-recibo">@p.FechaRecibo.ToShortDateString()</span>
            </td>

             <!-- Acciones -->
            <td>
              <div class="jug-actions">
                <a asp-action="Edit" asp-route-id="@p.idjugadorxEquipo"
                   title="Editar jugador" class="jug-btn edit">
                  <i class="bi bi-pencil"></i> Editar
                </a>
                <a asp-action="Pase" asp-route-id="@p.idjugadorxEquipo"
                   title="Transferencia" class="jug-btn pase">
                  <i class="bi bi-arrow-left-right"></i> Pase
                </a>
                <a asp-controller="Sanciones" asp-action="HistorialJugador" asp-route-id="@p.Idjugador"
                   title="Historial de sanciones" class="jug-btn sanc">
                  <i class="bi bi-shield-slash"></i> Sanciones
                </a>
                <a asp-action="GenerarCarnet" asp-route-idpjxe="@p.idjugadorxEquipo" asp-route-idjugador="0"
                   title="Generar PDF" target="_blank" class="jug-btn pdf">
                  <i class="bi bi-file-earmark-pdf"></i> Carnet PDF
                </a>
              </div>
            </td>

          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@section Scripts {
  <script>
    $(document).ready(function () {
      $(".jug-row").on("click", function (e) {
        if (!$(e.target).closest("a, button").length) {
          var href = $(this).data("href");
          if (href) window.location.href = href;
        }
      });
    });
  </script>
}
