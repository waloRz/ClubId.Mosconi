@using Microsoft.AspNetCore.Mvc.Filters
@using Microsoft.EntityFrameworkCore
@using ClubId.Data
@model ClubId.Models.ViewModels.JugadorPorEquipoViewModel

@{
    ViewData["Title"] = "Pase de Jugador";
}

@section Styles {
<link rel="stylesheet" href="~/css/pase.css" asp-append-version="true" />
}

<div class="pase-page">

  <div class="pase-header">
    <div>
      <div class="pase-eyebrow">Gestión de plantel</div>
      <h2 class="pase-title">Transferencia de Jugador</h2>
    </div>
    <a asp-action="Index" class="pase-back">
      <i class="bi bi-arrow-left"></i> Volver al listado
    </a>
  </div>

  @if (!string.IsNullOrEmpty(Model.MensajeSancion))
  {
    <div class="pase-alert">
      <i class="bi bi-exclamation-triangle-fill pase-alert-icon"></i>
      <div>
        <div class="pase-alert-title">Jugador con alerta activa</div>
        <p class="pase-alert-body mb-0">
          Observación pendiente: <strong>@Model.MensajeSancion.ToUpper()</strong>
        </p>
        <p class="pase-alert-note mb-0">
          <i class="bi bi-info-circle"></i>
          Verificá que la situación esté regularizada antes de imprimir el nuevo carnet.
        </p>
      </div>
    </div>
  }

  <form asp-action="Pase" method="post" enctype="multipart/form-data" id="formPase">
    <input type="hidden" asp-for="idjugadorxEquipo" />
    <input type="hidden" asp-for="Foto" />

    <div class="pase-grid">

      <!-- PANEL IZQUIERDO: Datos actuales -->
      <div class="pase-panel origin">
        <div class="pase-panel-head">
          <i class="bi bi-person-vcard"></i>
          <span class="pase-panel-head-title">Datos actuales</span>
        </div>
        <div class="pase-panel-body">

          <div class="pase-photo-wrap">
            <img src="~/fotosPerfiles/@Model.Foto" class="pase-photo"
                 onerror="this.src='/fotosPerfiles/default-user.webp';" alt="Foto" />
            <br/>
            <a asp-action="HistorialJugador" asp-controller="Sanciones"
               asp-route-id="@Model.Idjugador" target="_blank" class="pase-historial-link">
              <i class="bi bi-list-columns-reverse"></i> Historial de sanciones
            </a>
          </div>

          <div class="field-row" style="margin-top:1.25rem;">
            <div class="field-group">
              <span class="field-label">Nombre</span>
              <span class="field-value">@Model.Nombre</span>
            </div>
            <div class="field-group">
              <span class="field-label">Apellido</span>
              <span class="field-value">@Model.Apellido</span>
            </div>
          </div>
          <div class="field-row">
            <div class="field-group">
              <span class="field-label">DNI</span>
              <span class="field-value">@Model.Dni</span>
            </div>
            <div class="field-group">
              <span class="field-label">Fecha de nacimiento</span>
              <span class="field-value">@Model.FechaNac.ToString("dd/MM/yyyy")</span>
            </div>
          </div>

          <input type="hidden" asp-for="Nombre" />
          <input type="hidden" asp-for="Apellido" />
          <input type="hidden" asp-for="Dni" />
          <input type="hidden" asp-for="FechaNac" />

        </div>
      </div>

      <!-- FLECHA CENTRAL -->
      <div class="pase-arrow">
        <span class="pase-arrow-icon"><i class="bi bi-arrow-left-right"></i></span>
        <span class="pase-arrow-label">pase</span>
      </div>

      <!-- PANEL DERECHO: Nuevo fichaje -->
      <div class="pase-panel dest">
        <div class="pase-panel-head">
          <i class="bi bi-calendar-check"></i>
          <span class="pase-panel-head-title">Nuevo fichaje</span>
        </div>
        <div class="pase-panel-body">

          <div class="form-field fecha">
            <label asp-for="FechaRecibo">Fecha del pase</label>
            <input asp-for="FechaRecibo" class="form-control" type="date" required />
          </div>

          <div class="form-row">
            <div class="form-field">
              <label>Nueva categoría</label>
              <select asp-for="IdCategoria" class="form-select" asp-items="@Model.ListaCategoria">
                <option value="">Seleccionar categoría</option>
              </select>
            </div>
            <div class="form-field">
              <label>Nuevo equipo</label>
              <select asp-for="IdEquipo" class="form-select" asp-items="@Model.ListaEquipos">
                <option value="">Seleccionar equipo</option>
              </select>
            </div>
          </div>

          <div class="pase-switch-wrap">
            <input class="form-check-input" type="checkbox" asp-for="Activo"
                   role="switch" id="ActivoSwitch" />
            <div>
              <span class="pase-switch-label-title">Jugador habilitado</span>
              <span class="pase-switch-label-sub">Activa al jugador para competir en el nuevo equipo.</span>
            </div>
          </div>

        </div>
      </div>

    </div>

    <div class="pase-actions">
      <a asp-action="Index" class="btn-pase cancel">
        <i class="bi bi-x"></i> Cancelar
      </a>
      <button type="submit" name="proximaAccion" value="guardar"
              id="btnTransferir" class="btn-pase save" disabled
              onclick="enviarPase('guardar')">
        <i class="bi bi-check-lg"></i> Guardar
      </button>
      <button type="submit" name="proximaAccion" value="imprimir"
              id="btnTransferirImprimir" class="btn-pase print" disabled
              onclick="enviarPase('imprimir')">
        <i class="bi bi-printer-fill"></i> Guardar e imprimir carnet
      </button>
    </div>

  </form>
</div>

@section Scripts {
  @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

  <script>
    $(document).ready(function () {
      const categoriaSelect = $('#IdCategoria');
      const equipoSelect    = $('#IdEquipo');
      const fechaInput      = $('#FechaRecibo');
      const btn1 = $('#btnTransferir');
      const btn2 = $('#btnTransferirImprimir');

      let valoresIniciales = {
        categoria: categoriaSelect.val(),
        equipo:    equipoSelect.val(),
        fecha:     fechaInput.val()
      };

      function verificarCambios() {
        const catActual   = categoriaSelect.val();
        const eqActual    = equipoSelect.val();
        const fechaActual = fechaInput.val();
        const huboCambio  = catActual !== valoresIniciales.categoria ||
                            eqActual  !== valoresIniciales.equipo    ||
                            fechaActual !== valoresIniciales.fecha;
        const completo = catActual !== '' && eqActual !== '' && fechaActual !== '';
        const habilitar = huboCambio && completo;
        btn1.prop('disabled', !habilitar);
        btn2.prop('disabled', !habilitar);
      }

      categoriaSelect.on('change', function () {
        const categoriaId = $(this).val();
        equipoSelect.empty().prop('disabled', true)
          .append('<option value="">Buscando equipos\u2026</option>');
        if (categoriaId) {
          $.ajax({
            url:  '@Url.Action("GetEquiposPorCategoria", "Jgrxeqp")',
            type: 'GET',
            data: { idCategoria: categoriaId },
            success: function (data) {
              equipoSelect.empty().prop('disabled', false)
                .append('<option value="">Seleccionar equipo</option>');
              $.each(data, function (_, eq) {
                equipoSelect.append('<option value="' + eq.value + '">' + eq.text + '</option>');
              });
              verificarCambios();
            }
          });
        } else {
          equipoSelect.empty().prop('disabled', false)
            .append('<option value="">Seleccionar equipo</option>');
          verificarCambios();
        }
      });

      equipoSelect.on('change', verificarCambios);
      fechaInput.on('change keyup input', verificarCambios);

      if (categoriaSelect.val() !== '' && equipoSelect.children('option').length <= 1) {
        categoriaSelect.trigger('change');
      }
    });

    function enviarPase(accion) {
      const form = document.getElementById('formPase');
      if (accion === 'imprimir') {
        form.target = '_blank';
        setTimeout(function () {
          window.location.href = '@Url.Action("Index", "Jgrxeqp")';
        }, 1000);
      } else {
        form.target = '_self';
      }
    }
  </script>
}
