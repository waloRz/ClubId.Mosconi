@using Microsoft.AspNetCore.Mvc.Filters
@using Microsoft.EntityFrameworkCore
@using ClubId.Data
@model ClubId.Models.ViewModels.JugadorDetallesViewModel

@{
  ViewData["Title"] = "Detalle del Jugador";
}

@section Styles {
  <link rel="stylesheet" href="~/css/detalle-jugador.css" asp-append-version="true" />
}

<div class="det-page">

  <!-- ── Header ── -->
  <div class="det-nav">
    <div>
      <div class="det-eyebrow">
        <i class="bi bi-person-lines-fill me-1"></i> Ficha del jugador
      </div>
      <h2 class="det-title">
        <span>@Model.Apellido</span>, @Model.Nombre
      </h2>
    </div>
    <a asp-action="Index" class="det-back">
      <i class="bi bi-arrow-left"></i> Volver al listado
    </a>
  </div>

  <div class="det-grid">

    <!-- ══════════════════════════════
         PANEL IZQUIERDO — PERFIL
    ══════════════════════════════ -->
    <div class="det-perfil">

      <!-- Zona foto con fondo marino -->
      <div class="det-foto-zona">
        <div class="det-foto-frame">
          @if (!string.IsNullOrWhiteSpace(Model.Foto))
          {
            <img src="~/fotosPerfiles/@Model.Foto" alt="Foto de @Model.Nombre @Model.Apellido" />
          }
          else
          {
            <div class="det-foto-empty">
              <i class="bi bi-person-bounding-box"></i>
              <span>Sin foto</span>
            </div>
          }
        </div>

        <p class="det-foto-nombre">@Model.Nombre @Model.Apellido</p>
        <p class="det-foto-carnet">
          <i class="bi bi-credit-card-2-front me-1"></i> Carnet #@Model.JugadorId
        </p>

        @if (Model.Activo)
        {
          <span class="det-estado activo">
            <i class="bi bi-check-circle-fill"></i> Habilitado
          </span>
        }
        else
        {
          <span class="det-estado inactivo">
            <i class="bi bi-x-circle-fill"></i> Sancionado
          </span>
        }
      </div>

      <!-- Datos personales -->
      <div class="det-datos-lista">
        <div class="det-dato-item">
          <span class="det-dato-label">DNI</span>
          <span class="det-dato-value">@Model.Dni</span>
        </div>

        <div class="det-dato-item">
          <span class="det-dato-label">Nacimiento</span>
          <span class="det-dato-value">
            @Model.FechaNac.ToString("dd/MM/yyyy")
            @{
              // Convertimos el día de hoy a DateOnly para que coincida con el tipo de tu modelo
              var hoy = DateOnly.FromDateTime(DateTime.Today);
              var edad = hoy.Year - Model.FechaNac.Year;

              // Verificamos si en el año actual todavía no llegó la fecha de su cumpleaños
              if (hoy < Model.FechaNac.AddYears(edad))
              {
                edad--;
              }
            }
            <span class="text-muted ms-2">(@edad años)</span>
          </span>
        </div>

        <div class="det-dato-item">
          <span class="det-dato-label">N° Carnet</span>
          <span class="det-dato-value">@Model.JugadorId</span>
        </div>
      </div>
    </div>

  <!-- ══════════════════════════════
         PANEL DERECHO — HISTORIAL
    ══════════════════════════════ -->
    <div class="det-historial">
      <div class="det-historial-head">
        <i class="bi bi-shield-shaded"></i>
        <span class="det-historial-title">Historial de pertenencia a equipos</span>
      </div>

      <div class="table-responsive">
        <table class="det-table">
          <thead>
            <tr>
              <th>Equipo</th>
              <th>Categoría</th>
              <th>Fecha de recibo</th>
              <th class="text-center">Acción</th> <!-- Nueva columna -->
            </tr>
          </thead>
          <tbody>
            @if (Model.HistorialEquipos != null && Model.HistorialEquipos.Any())
            {
              @foreach (var p in Model.HistorialEquipos.OrderByDescending(x => x.FechaRecibo))
              {
                <tr>
                  <td>@p.NombreEquipo</td>
                  <td>
                    <span class="det-cat-badge">@p.NombreCat</span>
                  </td>
                  <td>
                    <span class="det-fecha">@p.FechaRecibo.ToShortDateString()</span>
                  </td>
                  <!-- Botón para imprimir carnet de este equipo específico -->
                  <td class="text-center">
                    <a asp-action="GenerarCarnet" 
                       asp-route-idjugador="@Model.JugadorId" 
                       asp-route-idpjxe="@p.idJxE" 
                       target="_blank"
                       class="btn btn-sm btn-outline-danger" 
                       title="Imprimir carnet de este equipo">
                      <i class="bi bi-printer"></i>
                    </a>
                  </td>
                </tr>
              }
            }
            else
            {
              <tr>
                <td colspan="4"> <!-- Cambiamos el colspan a 4 -->
                  <div class="det-table-empty">
                    <i class="bi bi-shield-slash"></i>
                    Este jugador no tiene historial de equipos registrado.
                  </div>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
    <!-- ══════════════════════════════
         BARRA DE ACCIONES
    ══════════════════════════════ -->
    <div class="det-actions">
      <a asp-action="Edit" asp-route-id="@Model.idJxEdit" class="btn-det edit">
        <i class="bi bi-pencil-square"></i> Editar jugador
      </a>
      <a asp-action="GenerarCarnet" asp-route-idjugador="@Model.JugadorId" asp-route-idpjxe="0" target="_blank"
         class="btn-det carnet">
        <i class="bi bi-file-earmark-pdf-fill"></i> Descargar carnet PDF
      </a>
      <a asp-action="Index" class="btn-det back">
        <i class="bi bi-arrow-left"></i> Volver
      </a>
    </div>

  </div><!-- /det-grid -->

</div>
