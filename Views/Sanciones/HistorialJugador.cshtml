@using ClubId.Data
@using Microsoft.AspNetCore.Mvc.Filters
@using Microsoft.EntityFrameworkCore
@using ClubId.Services
@model ClubId.Models.ViewModels.JugadorHistorialViewModel

@{
    ViewData["Title"] = $"Historial: {Model.NombreCompleto}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/historial-jugador.css" asp-append-version="true" />
}

<div class="hist-page">

  <!-- ── Navegación superior ── -->
  <div class="hist-nav">
    <span class="hist-eyebrow">
      <i class="bi bi-shield-exclamation me-1"></i> Expediente disciplinario
    </span>
    <a href="javascript:history.back()" class="hist-back">
      <i class="bi bi-arrow-left"></i> Volver
    </a>
  </div>

  <!-- ══════════════════════════════
       TARJETA DE PERFIL
  ══════════════════════════════ -->
  <div class="hist-perfil">
    <div class="hist-perfil-inner">

      <!-- Foto formato carnet -->
      <div class="hist-foto-col">
        <div class="hist-foto-frame">
          @if (!string.IsNullOrEmpty(Model.FotoUrl))
          {
            <img src="~/fotosPerfiles/@Model.FotoUrl" alt="Foto de @Model.NombreCompleto" />
          }
          else
          {
            <div class="hist-foto-empty">
              <i class="bi bi-person-bounding-box"></i>
              <span>Sin foto</span>
            </div>
          }
        </div>
        <span class="hist-foto-caption">Foto carnet</span>
      </div>

      <!-- Datos del jugador -->
      <div class="hist-datos-col">
        <h2 class="hist-nombre">@Model.NombreCompleto</h2>
        <span class="hist-carnet-chip">
          <i class="bi bi-credit-card-2-front"></i> Carnet #@Model.Carnet
        </span>

        <div class="hist-datos-grid">
          <div class="hist-dato">
            <span class="hist-dato-label">DNI</span>
            <span class="hist-dato-value">@Model.Dni</span>
          </div>
          <div class="hist-dato">
            <span class="hist-dato-label">Fecha de nacimiento</span>
            <span class="hist-dato-value">
              @(Model.FechaNacimiento.HasValue
                ? Model.FechaNacimiento.Value.ToString("dd/MM/yyyy")
                : "—")
            </span>
          </div>
          <div class="hist-dato">
            <span class="hist-dato-label">Total de sanciones</span>
            <span class="hist-dato-value" style="color: @(Model.Historial.Any() ? "var(--rojo)" : "var(--verde)")">
              @Model.Historial.Count()
            </span>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- ══════════════════════════════
       HISTORIAL DE SANCIONES
  ══════════════════════════════ -->
  <div class="hist-table-card">

    <div class="hist-table-head">
      <i class="bi bi-clock-history"></i>
      <span class="hist-table-title">Historial de sanciones</span>
    </div>

    <div class="table-responsive">
      <table class="hist-table">
        <thead>
          <tr>
            <th>Fecha sanción</th>
            <th>Equipo</th>
            <th>Sanción aplicada</th>
            <th>Informe / Motivo</th>
            <th>Reporte</th>
          </tr>
        </thead>
        <tbody>
          @if (Model.Historial.Any())
          {
            @foreach (var item in Model.Historial)
            {
              <tr>
                <td>
                  <span class="hist-fecha">@item.FechaSancion.ToString("dd/MM/yyyy")</span>
                </td>
                <td>
                  <span class="hist-equipo-badge">
                    <i class="bi bi-shield-shaded me-1"></i>@item.NombreEquipo
                  </span>
                </td>
                <td>
                  <span class="hist-sancion">@item.DetalleSancion</span>
                </td>
                <td>
                  <span class="hist-informe">@item.Informe</span>
                </td>
                <td>
                  <a asp-action="GenerarBoletin" asp-controller="Sanciones"
                     asp-route-id="@item.IdSancion"
                     class="btn-reporte" target="_blank">
                    <i class="bi bi-file-earmark-pdf-fill"></i> Reporte
                  </a>
                </td>
              </tr>
            }
          }
          else
          {
            <tr>
              <td colspan="5">
                <div class="hist-empty">
                  <i class="bi bi-shield-check hist-empty-icon"></i>
                  <p class="hist-empty-title">Registro limpio</p>
                  <p class="hist-empty-sub">
                    Este jugador no registra sanciones en el sistema.
                  </p>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>

  </div>

</div>
