@using ClubId.Data
@using Microsoft.AspNetCore.Mvc.Filters
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Mvc.Rendering
@using ClubId.Services

@model IEnumerable<ClubId.Models.ViewModels.BoletinSancionesViewModel>

@{
    ViewData["Title"] = "Historial de Boletines";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/boletines.css" asp-append-version="true" />
}

<div class="bol-page">

  <!-- ── Header ── -->
  <div class="bol-header">
    <div class="bol-header-left">
      <div class="bol-icon-wrap">
        <i class="bi bi-shield-exclamation"></i>
      </div>
      <div>
        <div class="bol-eyebrow">Disciplina</div>
        <h2 class="bol-title">Gestión de Boletines</h2>
        <p class="bol-subtitle">Consultá, editá o publicá nuevos informes de sanciones.</p>
      </div>
    </div>
    <a asp-action="Create" class="btn-nuevo-bol">
      <i class="bi bi-plus-lg"></i> Nuevo Boletín
    </a>
  </div>

  <!-- ── Card tabla ── -->
  <div class="bol-card">
    <div class="table-responsive">
      <table id="tablaBoletines" class="table align-middle mb-0">
        <thead>
          <tr>
            <th>Fecha </th>
            <th>Nro. Fecha</th>
            <th>Categoría</th>
            <th>Comunicado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          @if (Model != null && Model.Any())
          {
            @foreach (var item in Model)
            {
              <tr>
                <td data-order="@item.FechaBoletin.ToString("yyyyMMdd")">
                  <span class="bol-fecha">@item.FechaBoletin.ToString("dd/MM/yyyy")</span>
                </td>

                <td>
                  <span class="bol-badge-fecha">
                    <i class="bi bi-calendar3 me-1"></i> Fecha #@item.NroFecha
                  </span>
                </td>

                <td>
                  <span class="bol-categoria">@item.NombreCat</span>
                </td>

                <td>
                  <span class="bol-comunicado" title="@item.Comunicado">@item.Comunicado</span>
                </td>

                <td>
                  <div class="bol-actions">
                    <a asp-action="GenerarBoletin" asp-route-id="@item.IdSanciones"
                       target="_blank" class="bol-btn pdf" title="Generar PDF">
                      <i class="bi bi-file-earmark-pdf"></i> PDF
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.IdSanciones"
                       class="bol-btn edit" title="Editar boletín">
                      <i class="bi bi-pencil"></i> Editar
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.IdSanciones"
                       class="bol-btn del" title="Eliminar boletín">
                      <i class="bi bi-trash"></i> Eliminar
                    </a>
                    <a asp-action="PlanillaExcel" asp-route-id="@item.IdSanciones" class="btn btn-success" target="_blank">
  <i class="bi bi-file-earmark-excel"></i> 
</a>
                  </div>
                </td>
              </tr>
            }
          }
          else
          {
            <tr>
              <td colspan="5">
                <div class="bol-empty">
                  <i class="bi bi-journal-x bol-empty-icon"></i>
                  <p class="bol-empty-title">No hay boletines cargados todavía</p>
                  <p class="bol-empty-sub">
                    Usá el botón <strong>Nuevo Boletín</strong> para registrar el primero.
                  </p>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>

</div>

@section Scripts {
  <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

  <script>
    $(document).ready(function () {
      $('#tablaBoletines').DataTable({
        language: {
          url: 'https://cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json'
        },
        responsive: true,
        dom: '<"d-flex justify-content-between align-items-center flex-wrap"f>rt<"d-flex justify-content-between align-items-center flex-wrap p-3"ip>',
        pageLength: 10,
        order: [[0, 'desc']]
      });
    });
  </script>
}
