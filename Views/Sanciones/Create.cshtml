@model ClubId.Models.ViewModels.SancionCreacionViewModel

@{
    ViewData["Title"] = "Nuevo Boletín de Sanciones";
}

@section Styles {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/crear-boletin.css" asp-append-version="true" />
}

<div class="cb-page">

  <!-- ── Header ── -->
  <div class="cb-header">
    <div class="cb-header-left">
      <div class="cb-icon-wrap">
        <i class="bi bi-shield-fill-exclamation"></i>
      </div>
      <div>
        <div class="cb-eyebrow">Disciplina</div>
        <h2 class="cb-title">Nuevo Boletín de Sanciones</h2>
        <p class="cb-subtitle">Completá los datos del boletín y sumá los jugadores sancionados.</p>
      </div>
    </div>
    <a asp-action="Index" class="cb-back">
      <i class="bi bi-arrow-left"></i> Volver a Boletines
    </a>
  </div>

  <!-- ── Formulario ── -->
  <form method="post" enctype="multipart/form-data" id="formBoletin">
    <input type="hidden" asp-for="IdSanciones" />

    @if (!ViewData.ModelState.IsValid)
    {
      <div class="cb-validation" asp-validation-summary="ModelOnly" role="alert"></div>
    }

    <div class="cb-card">

      <!-- ══ SECCIÓN 1: Datos del boletín ══ -->
      <div class="cb-section">
        <div class="cb-section-head">
          <h4 class="cb-section-title">
            <i class="bi bi-newspaper"></i> Datos principales del boletín
          </h4>
        </div>

        <div class="cb-fields-row">
          <div class="cb-field">
            <label asp-for="FechaBoletin">Fecha de publicación</label>
            <input asp-for="FechaBoletin" type="date" class="form-control" />
            <span asp-validation-for="FechaBoletin" class="text-danger"></span>
          </div>
          <div class="cb-field">
            <label asp-for="NroFecha">Nro. de fecha</label>
            <input type="number" asp-for="NroFecha" class="form-control" min="1" max="99" required />
          </div>
          <div class="cb-field">
            <label asp-for="IdCategoria">Categoría</label>
            <select asp-for="IdCategoria" class="form-select" asp-items="ViewBag.IdCategoria">
              <option value="">— Seleccionar —</option>
            </select>
            <span asp-validation-for="IdCategoria" class="text-danger"></span>
          </div>
          <div class="cb-field">
            <label asp-for="Comunicado">Comunicado general</label>
            <textarea asp-for="Comunicado" class="form-control" rows="3"
                      placeholder="Texto del comunicado oficial del boletín…"></textarea>
            <span asp-validation-for="Comunicado" class="text-danger"></span>
          </div>
        </div>
      </div>

      <!-- ══ SECCIÓN 2: Ingreso de jugadores ══ -->
      <div class="cb-section">
        <div class="cb-section-head">
          <h4 class="cb-section-title">
            <i class="bi bi-person-fill-slash"></i> Jugadores sancionados
          </h4>
          <button type="button" id="btnAddJugador" class="btn-add-jugador">
            <i class="bi bi-plus-lg"></i> Agregar jugador
          </button>
        </div>

        <!-- Panel de ingreso -->
        <div class="cb-jugador-panel">

          <!-- Fila superior: búsquedas + switch -->
          <div class="cb-jugador-row-top">
            <div class="cb-field">
              <label for="JugadorSearch">Jugador</label>
              <select id="JugadorSearch" class="form-select w-100"></select>
            </div>
            <div class="cb-field">
              <label for="EquipoSearch">Equipo</label>
              <select id="EquipoSearch" class="form-select w-100"></select>
            </div>
            <div class="cb-field" style="display:flex; align-items:flex-end;">
              <div class="cb-switch-wrap" style="width:100%">
                <input class="form-check-input" type="checkbox" id="AlertaPase" role="switch" />
                <div>
                  <span class="cb-switch-label-title">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Advertencia en pase
                  </span>
                  <span class="cb-switch-label-sub">Mostrar alerta al realizar un pase de este jugador.</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Fila inferior: motivo + artículos -->
          <div class="cb-jugador-row-mid">
            <div class="cb-field" style="margin:0">
              <label for="txtMotivo">Informe del árbitro</label>
              <textarea id="txtMotivo" class="form-control" rows="3" maxlength="600"
                        placeholder="Describí el incidente, la falta o el motivo de la sanción…">Sin Informe</textarea>
              <div class="cb-motivo-footer">
                <span class="cb-motivo-limit">Máximo 500 caracteres</span>
                <span id="motivoCount" class="cb-motivo-count">0 / 500</span>
              </div>
              <span id="motivoError" class="cb-motivo-error">
                <i class="bi bi-exclamation-circle me-1"></i>Superaste el límite de 500 caracteres
              </span>
            </div>
            <div class="cb-articulos-wrap" style="min-width:350px">
              <label for="txtArticulo">Sanción y artículos</label>
              <textarea id="txtArticulo" rows="3"
                        placeholder="Ej: Art. 204 — 2 partidos"></textarea>
            </div>
          </div>

        </div><!-- /cb-jugador-panel -->

        <!-- Tabla de sancionados -->
        <div class="cb-table-wrap">
          <table id="jugadoresTable" class="table align-middle mb-0">
            <thead>
              <tr>
                <th style="width:4%">#</th>
                <th style="width:10%">DNI</th>
                <th style="width:20%">Jugador</th>
                <th style="width:18%">Equipo</th>
                <th style="width:16%">Sanción / Artículos</th>
                <th>Informe del árbitro</th>
                <th style="width:8%;text-align:center">Quitar</th>
              </tr>
            </thead>
            <tbody>
              @if (Model.JugadoresSancionados.Any())
              {
                for (int i = 0; i < Model.JugadoresSancionados.Count; i++)
                {
                  var item = Model.JugadoresSancionados[i];
                  <tr data-id="@item.IdJugador">
                    <td>@(i + 1)</td>
                    <td>@item.Dni</td>
                    <td>
                      @item.NombreCompleto
                      @if (item.AlertaPase)
                      {
                        <span class="badge-alerta">
                          <i class="bi bi-exclamation-triangle-fill"></i> Alerta
                        </span>
                      }
                    </td>
                    <td>@item.NombreEq</td>
                    <td>
                      <input type="text"
                             name="JugadoresSancionados[@i].CantidadPartidos"
                             value="@item.CantidadPartidos"
                             class="input-articulo" />
                      <input type="hidden" name="JugadoresSancionados[@i].IdSanciones"    value="@item.IdSanciones" />
                      <input type="hidden" name="JugadoresSancionados[@i].IdJugador"       value="@item.IdJugador" />
                      <input type="hidden" name="JugadoresSancionados[@i].Nombre"          value="@item.Nombre" />
                      <input type="hidden" name="JugadoresSancionados[@i].Apellido"        value="@item.Apellido" />
                      <input type="hidden" name="JugadoresSancionados[@i].AlertaPase"      value="@item.AlertaPase.ToString().ToLower()" />
                      <input type="hidden" name="JugadoresSancionados[@i].Dni"             value="@item.Dni" />
                      <input type="hidden" name="JugadoresSancionados[@i].IdEquipo"        value="@item.IdEquipo" />
                      <input type="hidden" name="JugadoresSancionados[@i].NombreEq"        value="@item.NombreEq" />
                      <input type="hidden" name="JugadoresSancionados[@i].NombreCompleto"  value="@item.NombreCompleto" />
                    </td>
                    <td>
                      <textarea name="JugadoresSancionados[@i].MotivoEspecifico"
                                class="input-motivo" rows="2">@item.MotivoEspecifico</textarea>
                    </td>
                    <td>
                      <button type="button" class="btn-remove-jugador btn-remove">
                        <i class="bi bi-trash"></i>
                      </button>
                    </td>
                  </tr>
                }
              }
              else
              {
                <tr id="emptyRow">
                  <td colspan="7">
                    <div class="cb-table-empty">
                      <i class="bi bi-person-fill-slash"></i>
                      Todavía no hay jugadores en el boletín. Usá el panel de arriba para agregarlos.
                    </div>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div><!-- /cb-table-wrap -->

      </div><!-- /sección jugadores -->

      <!-- ══ ACCIONES ══ -->
      <div class="cb-section">
        <div class="cb-actions">
          <a asp-action="Index" class="btn-cb cancel">
            <i class="bi bi-x"></i> Cancelar
          </a>
          <button type="submit" class="btn-cb save">
            <i class="bi bi-check-lg"></i> Guardar boletín
          </button>
        </div>
      </div>

    </div><!-- /cb-card -->
  </form>
</div>

@section Scripts {
  @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
  <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/js/select2.full.min.js"></script>

 <script>
    var jugadorIndex = @(Model.JugadoresSancionados.Any() ? Model.JugadoresSancionados.Count : 0);
    const maxLength = 500;

    $(document).ready(function () {

      /* ── Contador motivo ── */
      const $motivo      = $('#txtMotivo');
      const $motivoCount = $('#motivoCount');
      const $motivoError = $('#motivoError');

      $motivo.on('input', function () {
        const len = $(this).val().length;
        $motivoCount.text(len + ' / ' + maxLength);
        $motivoCount.removeClass('warn danger');
        if (len > maxLength) {
          $motivoCount.addClass('danger');
          $motivoError.show();
        } else if (len > maxLength * .8) {
          $motivoCount.addClass('warn');
          $motivoError.hide();
        } else {
          $motivoError.hide();
        }
      });

/* ── FIX PARA EL FOCO AUTOMÁTICO EN SELECT2 ── */
      $(document).on('select2:open', function(e) {
          // Usamos un pequeñísimo retardo (0 ms suele bastar para que el DOM se actualice)
          // para asegurarnos de que la caja de texto ya existe antes de enfocarla.
          setTimeout(function() {
              document.querySelector('.select2-container--open .select2-search__field').focus();
          }, 10);
      });
      
      /* ── Select2: Jugadores ── */
      $('#JugadorSearch').select2({
        placeholder: 'Buscá por apellido, nombre o DNI…',
        minimumInputLength: 3,
        ajax: {
          url: '@Url.Action("BuscarJugadores", "Sanciones")',
          dataType: 'json', delay: 300,
          data: p => ({ term: p.term.trim() }),
          processResults: d => ({ results: d.results }),
          cache: true
        }
      });

      /* ── Select2: Equipos ── */
      $('#EquipoSearch').select2({
        placeholder: 'Escribí el nombre del equipo…',
        minimumInputLength: 3,
        ajax: {
          url: '@Url.Action("BuscarEquipos", "Sanciones")',
          dataType: 'json', delay: 250,
          // SOLUCIÓN MINÚSCULAS: Forzamos el texto a minúsculas antes de enviarlo
          data: p => ({ term: p.term }), 
          processResults: d => ({ results: d.results }),
          cache: true
        }
      });

      /* ── FLUJO DE FOCUS AUTOMÁTICO ── */
      
      // 1. Al seleccionar un Jugador -> Enfoca y abre Equipo
      $('#JugadorSearch').on('select2:select', function (e) {
          $('#EquipoSearch').select2('open');
      });

      // 2. Al seleccionar un Equipo -> Enfoca Sanción/Artículos
      $('#EquipoSearch').on('select2:select', function (e) {
          $('#txtArticulo').focus();
      });

      // (Opcional) Si querés que con presionar 'Enter' en Artículos vaya al botón Agregar
      $('#txtArticulo').on('keypress', function(e) {
          if (e.which == 13) { 
              e.preventDefault(); 
              $('#btnAddJugador').click(); 
          }
      });


      /* ── Reindexar filas ── */
      function reIndexTable() {
        $('#jugadoresTable tbody tr:not(#emptyRow)').each(function (i) {
          $(this).find('input, textarea').each(function () {
            const n = $(this).attr('name');
            if (n) $(this).attr('name', n.replace(/\[\d+\]/g, '[' + i + ']'));
          });
          $(this).find('td:first-child').text(i + 1);
        });
        jugadorIndex = $('#jugadoresTable tbody tr:not(#emptyRow)').length;
      }

      /* ── Agregar jugador ── */
      $('#btnAddJugador').on('click', function () {
        const sd        = $('#JugadorSearch').select2('data')[0];
        const ed        = $('#EquipoSearch').select2('data')[0];
        const motivo    = $motivo.val().trim();
        const articulos = $('#txtArticulo').val().trim();
        const alerta    = $('#AlertaPase').is(':checked');

        if (!sd)     { alert('Seleccioná un jugador.'); return; }
        if (!ed)     { alert('Seleccioná un equipo.');  return; }
        if (!motivo) { alert('Completá el informe del árbitro.'); return; }
        if (motivo.length > maxLength) {
          alert('El informe supera los ' + maxLength + ' caracteres (' + motivo.length + ').');
          $motivo.focus(); return;
        }
        if ($('#jugadoresTable tbody tr[data-id="' + sd.id + '"]').length > 0) {
          alert('Este jugador ya está en el boletín.'); return;
        }

        const safeMotivo = motivo.replace(/</g, '&lt;').replace(/>/g, '&gt;');
        const alertaBadge = alerta
          ? '<span class="badge-alerta"><i class="bi bi-exclamation-triangle-fill"></i> Alerta</span>'
          : '';

        const idx = jugadorIndex;
        const row = `
          <tr data-id="${sd.id}">
            <td>${idx + 1}</td>
            <td>${sd.dni}</td>
            <td>${sd.nombreCompleto} ${alertaBadge}</td>
            <td>${ed.nombreEquipo}</td>
            <td>
              <input type="text"  name="JugadoresSancionados[${idx}].CantidadPartidos" value="${articulos}" class="input-articulo" />
              <input type="hidden" name="JugadoresSancionados[${idx}].IdJugador"       value="${sd.id}" />
              <input type="hidden" name="JugadoresSancionados[${idx}].Nombre"          value="${sd.nombre}" />
              <input type="hidden" name="JugadoresSancionados[${idx}].Apellido"        value="${sd.apellido}" />
              <input type="hidden" name="JugadoresSancionados[${idx}].NombreCompleto"  value="${sd.nombreCompleto}" />
              <input type="hidden" name="JugadoresSancionados[${idx}].Dni"             value="${sd.dni}" />
              <input type="hidden" name="JugadoresSancionados[${idx}].IdEquipo"        value="${ed.id}" />
              <input type="hidden" name="JugadoresSancionados[${idx}].NombreEq"        value="${ed.nombreEquipo}" />
              <input type="hidden" name="JugadoresSancionados[${idx}].AlertaPase"      value="${alerta}" />
            </td>
            <td>
              <textarea name="JugadoresSancionados[${idx}].MotivoEspecifico" class="input-motivo" rows="2">${safeMotivo}</textarea>
            </td>
            <td>
              <button type="button" class="btn-remove-jugador btn-remove">
                <i class="bi bi-trash"></i>
              </button>
            </td>
          </tr>`;

        $('#emptyRow').remove();
        $('#jugadoresTable tbody').append(row);
        jugadorIndex++;

        /* limpiar panel */
        $('#JugadorSearch, #EquipoSearch').val(null).trigger('change');
        $('#txtArticulo').val('');
        $motivo.val('Sin Informe');
        $('#AlertaPase').prop('checked', false);
        $motivoCount.text('0 / ' + maxLength).removeClass('warn danger');
        
        // 3. Devolvemos el foco al buscador de jugadores para el siguiente
        $('#JugadorSearch').select2('open');
      });

      /* ── Quitar jugador ── */
      $('#jugadoresTable').on('click', '.btn-remove', function () {
        $(this).closest('tr').remove();
        reIndexTable();
        if ($('#jugadoresTable tbody tr').length === 0) {
          $('#jugadoresTable tbody').append(`
            <tr id="emptyRow">
              <td colspan="7">
                <div class="cb-table-empty">
                  <i class="bi bi-person-fill-slash"></i>
                  Todavía no hay jugadores en el boletín.
                </div>
              </td>
            </tr>`);
        }
      });

      reIndexTable();
    });
  </script>>
}
