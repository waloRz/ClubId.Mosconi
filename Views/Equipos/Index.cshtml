@using ClubId.Data
@using Microsoft.AspNetCore.Mvc.Filters
@using Microsoft.EntityFrameworkCore
@using ClubId.Models.ViewModels
@model IEnumerable<ClubId.Models.ViewModels.EquipoViewModel>

@{ ViewData["Title"] = "Equipos"; }

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/v/bs5/dt-1.13.4/datatables.min.css" />
    <link rel="stylesheet" href="~/css/equipos.css" asp-append-version="true" />
}

<div class="eq-page">

  <!-- ── Header ── -->
  <div class="eq-header">
    <div>
      <div class="eq-eyebrow">
        <i class="bi bi-shield-shaded me-1"></i> Plantel
      </div>
      <h2 class="eq-title">Equipos</h2>
      <p class="eq-subtitle">Administrá los equipos, delegados y su categoría asignada.</p>
    </div>
    <a asp-action="Create" class="btn-nuevo-eq">
      <i class="bi bi-plus-lg"></i> Nuevo equipo
    </a>
  </div>

  <!-- ── Card tabla ── -->
  <div class="eq-card">
    <table id="tablaEquipos" class="table align-middle mb-0">
      <thead>
        <tr>
          <th style="width:80px">Escudo</th>
          <th>Nombre</th>
          <th>Categoría</th>
          <th>Delegado</th>
          <th style="width:110px">Estado</th>
          <th style="width:120px">Acciones</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var item in Model)
        {
          <tr>

            <!-- Escudo -->
            <td>
              @if (!string.IsNullOrEmpty(item.FotoEq))
              {
                <img src="~/imagenes/equipos/@item.FotoEq"
                     class="eq-escudo-img" alt="Escudo @item.NombreEq" />
              }
              else
              {
                <div class="eq-escudo-placeholder">
                  <i class="bi bi-shield-shaded"></i>
                </div>
              }
            </td>

            <!-- Nombre -->
            <td>
              <span class="eq-nombre">@item.NombreEq</span>
            </td>

            <!-- Categoría -->
            <td>
              <span class="eq-cat-badge">@item.NombreCategoria</span>
            </td>

            <!-- Delegado -->
            <td>
              <span class="eq-delegado-nombre">@item.Delegado</span>
              @if (!string.IsNullOrWhiteSpace(item.Celular))
              {
                <span class="eq-delegado-tel">
                  <i class="bi bi-whatsapp"></i> @item.Celular
                </span>
              }
            </td>

            <!-- Estado -->
            <td>
              @if (item.Estado)
              {
                <span class="eq-estado activo">Activo</span>
              }
              else
              {
                <span class="eq-estado inactivo">Inactivo</span>
              }
            </td>

            <!-- Acciones -->
            <td>
              <a asp-action="Edit" asp-route-id="@item.IdEquipo"
                 class="btn-editar-eq" title="Editar equipo">
                <i class="bi bi-pencil"></i> Editar
              </a>
            </td>

          </tr>
        }
      </tbody>
    </table>
  </div>

</div>

@section Scripts {
  <script src="https://cdn.datatables.net/v/bs5/dt-1.13.4/datatables.min.js"></script>
  <script>
    $(document).ready(function () {
      $('#tablaEquipos').DataTable({
        language: {
          url: 'https://cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json'
        },
        dom: '<"d-flex justify-content-between align-items-center flex-wrap"lf>rt<"d-flex justify-content-between align-items-center flex-wrap p-3"ip>',
        lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "Todos"]],
        order: [[1, 'asc']],
        searching: true,
        paging: true,
        lengthChange: true,
        columnDefs: [
          { orderable: false, targets: [0, 5] }
        ]
      });
    });
  </script>
}
