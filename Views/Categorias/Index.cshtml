@model IEnumerable<CategoriaViewModel>

@{
    ViewData["Title"] = "Gestión de Categorías";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/v/bs5/dt-1.13.4/datatables.min.css" />
    <link rel="stylesheet" href="~/css/categorias.css" asp-append-version="true" />
}

<div class="cat-page">

  <!-- ── Header ── -->
  <div class="cat-header">
    <div>
      <div class="cat-eyebrow">
        <i class="bi bi-tags-fill me-1"></i> Configuración
      </div>
      <h2 class="cat-title">Categorías</h2>
      <p class="cat-subtitle">Administrá las categorías y sus colores de carnet.</p>
    </div>
    <a asp-action="Create" class="btn-nueva-cat">
      <i class="bi bi-plus-lg"></i> Nueva categoría
    </a>
  </div>

  <!-- ── Card tabla ── -->
  <div class="cat-card">
    <table id="tablaCategorias" class="table align-middle mb-0">
      <thead>
        <tr>
          <th style="width:60px">ID</th>
          <th>Nombre</th>
          <th style="width:200px">Color carnet</th>
          <th style="width:120px">Estado</th>
          <th style="width:130px">Acciones</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var item in Model)
        {
          <tr>
            <td>
              <span class="cat-id-chip">@item.IdCategoria</span>
            </td>
            <td>
              <span class="cat-nombre">@item.NombreCat</span>
            </td>
            <td>
              <div class="cat-color-wrap">
                <div class="cat-color-swatch" style="background-color: @item.Color;"
                     title="@item.Color"></div>
                <span class="cat-color-hex">@item.Color</span>
              </div>
            </td>
            <td>
              @if (item.EstadoCat)
              {
                <span class="cat-estado activa">Activa</span>
              }
              else
              {
                <span class="cat-estado inactiva">Inactiva</span>
              }
            </td>
            <td>
              <a asp-action="Edit" asp-route-id="@item.IdCategoria"
                 class="btn-editar-cat" title="Editar categoría">
                <i class="bi bi-pencil"></i> Editar
              </a>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>

</div>

@section Scripts {
    <script src="https://cdn.datatables.net/v/bs5/dt-1.13.4/datatables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#tablaCategorias').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json'
                },
                dom: '<"d-flex justify-content-between align-items-center flex-wrap"lf>rt<"d-flex justify-content-between align-items-center flex-wrap p-3"ip>',
                lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, "Todos"]],
                order: [[1, 'asc']],
                searching: true,
                paging: true,
                lengthChange: true
            });
        });
    </script>
}
