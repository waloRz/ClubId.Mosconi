@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - Mosconi</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  @await RenderSectionAsync("Styles", required: false)

  <link rel="icon" type="image/x-icon" href="~/imgFijas/favicon.ico" />
  <link rel="manifest" href="~/manifest.json">
  <meta name="theme-color" content="#0F1117">

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/service-worker.js');
      });
    }
  </script>
<link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
</head>

<body>

  <!-- ══ SIDEBAR (desktop) ══ -->
  <aside class="app-sidebar" id="appSidebar">
    <a class="sidebar-brand" asp-controller="Jgrxeqp" asp-action="Index">
      <div class="sidebar-brand-icon"><i class="bi bi-trophy-fill"></i></div>
      <div class="sidebar-brand-text">
        <span class="sidebar-brand-name">Predio Mosconi</span>
        <span class="sidebar-brand-sub">Gestión deportiva</span>
      </div>
    </a>

    <nav class="sidebar-nav">
      <div class="sidebar-section-label">Plantel</div>
      <a class="sidebar-link" asp-controller="Jgrxeqp" asp-action="Index">
        <i class="bi bi-people-fill"></i> Jugadores
      </a>
      <a class="sidebar-link" asp-controller="Equipos" asp-action="Index">
        <i class="bi bi-shield-shaded"></i> Equipos
      </a>
      <a class="sidebar-link" asp-controller="Categorias" asp-action="Index">
        <i class="bi bi-tags-fill"></i> Categorías
      </a>

      <div class="sidebar-section-label">Disciplina</div>
      <a class="sidebar-link warn-link" asp-controller="Sanciones" asp-action="Index">
        <i class="bi bi-exclamation-triangle-fill"></i> Sanciones
      </a>

      <div class="sidebar-section-label">Análisis</div>
      <button class="sidebar-toggle" id="reportesToggle">
        <i class="bi bi-file-earmark-bar-graph-fill"></i> Reportes
        <i class="bi bi-chevron-down"></i>
      </button>
      <div class="sidebar-sub" id="reportesSub">
        <a class="sidebar-sub-link" asp-controller="Reportes" asp-action="GenerarReporte">
          <i class="bi bi-people"></i> Jugadores SuspExp
        </a>
        <a class="sidebar-sub-link" asp-controller="Reportes" asp-action="Sancionados">
          <i class="bi bi-exclamation-octagon"></i> Sanciones x Fecha
        </a>
        <a class="sidebar-sub-link" asp-controller="Reportes" asp-action="JugadoresExpulsados" target="_blank">
          <i class="bi bi-exclamation-octagon"></i> Expulsados
        </a>
        <a class="sidebar-sub-link" asp-controller="Reportes" asp-action="Index">
          <i class="bi bi-grid"></i> Ver todos
        </a>
      </div>
    </nav>

    <div class="sidebar-footer">
      &copy; 2025 ClubId · <a href="https://wa.me/3874434836"  target="_blank" class="footer-link">Soporte</a>
    </div>
  </aside>

  <!-- ══ TOPBAR (mobile) ══ -->
  <header class="app-topbar" id="appTopbar">
    <a class="topbar-brand" asp-controller="Jgrxeqp" asp-action="Index">
      <div class="topbar-brand-icon"><i class="bi bi-trophy-fill"></i></div>
      <span class="topbar-brand-name">Mosconi</span>
    </a>
    <button class="topbar-burger" id="mobileMenuBtn" aria-label="Menú">
      <i class="bi bi-list"></i>
    </button>
  </header>

  <!-- Mobile nav overlay -->
  <div class="mobile-nav-overlay" id="mobileNav">
    <div class="mobile-nav-backdrop" id="mobileBackdrop"></div>
    <div class="mobile-nav-panel">
      <!-- reuse same sidebar content -->
      <a class="sidebar-brand" asp-controller="Jgrxeqp" asp-action="Index">
        <div class="sidebar-brand-icon"><i class="bi bi-trophy-fill"></i></div>
        <div class="sidebar-brand-text">
          <span class="sidebar-brand-name">Predio Mosconi</span>
          <span class="sidebar-brand-sub">Gestión deportiva</span>
        </div>
      </a>
      <nav class="sidebar-nav">
        <div class="sidebar-section-label">Plantel</div>
        <a class="sidebar-link" asp-controller="Jgrxeqp" asp-action="Index">
          <i class="bi bi-people-fill"></i> Jugadores
        </a>
        <a class="sidebar-link" asp-controller="Equipos" asp-action="Index">
          <i class="bi bi-shield-shaded"></i> Equipos
        </a>
        <a class="sidebar-link" asp-controller="Categorias" asp-action="Index">
          <i class="bi bi-tags-fill"></i> Categorías
        </a>
        <div class="sidebar-section-label">Disciplina</div>
        <a class="sidebar-link warn-link" asp-controller="Sanciones" asp-action="Index">
          <i class="bi bi-exclamation-triangle-fill"></i> Sanciones
        </a>
        <div class="sidebar-section-label">Análisis</div>
        <a class="sidebar-link" asp-controller="Reportes" asp-action="GenerarReporte">
          <i class="bi bi-people"></i> Jug. SuspExp
        </a>
        <a class="sidebar-link" asp-controller="Reportes" asp-action="Sancionados">
          <i class="bi bi-exclamation-octagon"></i> Sanciones x Fecha
        </a>
        <a class="sidebar-link" asp-controller="Reportes" asp-action="JugadoresExpulsados" target="_blank">
          <i class="bi bi-exclamation-octagon"></i> Expulsados
        </a>
        <a class="sidebar-link" asp-controller="Reportes" asp-action="Index">
          <i class="bi bi-grid"></i> Todos los reportes
        </a>
      </nav>
    </div>
  </div>

  <!-- ══ SHELL ══ -->
  <div class="app-shell">
    <div class="app-main">
      <div class="app-content">
        @RenderBody()
      </div>

      <footer class="app-footer">
        <p class="footer-copy mb-0">
          &copy; 2025 <strong>ClubId</strong> — Gestión Deportiva Inteligente
        </p>
        <a href="#" class="footer-link">V26.7.2</a>
      </footer>
    </div>
  </div>

  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
          integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
          crossorigin="anonymous"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)

  <script>
    $(document).ready(function () {
      // ── Active nav link ──
      var currentPath = window.location.pathname.toLowerCase();
      $('.sidebar-link, .sidebar-sub-link').each(function () {
        var href = $(this).attr('href');
        if (!href) return;
        var linkPath = href.toLowerCase();
        if (currentPath === linkPath || (linkPath !== '/' && currentPath.indexOf(linkPath) !== -1)) {
          $(this).addClass('active-link');
          // Open parent sub if active link is inside it
          $(this).closest('.sidebar-sub').addClass('open');
          $(this).closest('.sidebar-sub').prev('.sidebar-toggle').addClass('open');
        }
      });

      // ── Reportes accordion ──
      $('#reportesToggle').on('click', function () {
        $(this).toggleClass('open');
        $('#reportesSub').toggleClass('open');
      });

      // ── Mobile menu ──
      $('#mobileMenuBtn').on('click', function () {
        $('#mobileNav').addClass('open');
      });
      $('#mobileBackdrop').on('click', function () {
        $('#mobileNav').removeClass('open');
      });
    });
  </script>

</body>
</html>
