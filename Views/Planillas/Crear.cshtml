@model ClubId.Models.ViewModels.PlanillaViewModel

@{
    ViewData["Title"] = "Generar Planilla de Equipo";
}

<div class="container py-4">
    <div class="card shadow-lg mb-4">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0"><i class="bi bi-file-earmark-person"></i> Armado de Planilla</h3>
        </div>
        <div class="card-body">

            @* --- ZONA DE BÚSQUEDA Y PREVISUALIZACIÓN --- *@
            <div class="row g-3 mb-4 p-3 border rounded bg-light align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-bold">Buscar Jugador (DNI exacto, Apellido o Nombre)</label>
                    @* Asignamos tabindex 1 al buscador *@
                    <select id="JugadorSearch" class="form-select w-100" tabindex="1"></select>
                </div>
                <div class="col-md-2">
                    @* Asignamos tabindex 2 al botón Mostrar *@
                    <button type="button" id="btnMostrar" class="btn btn-info w-100 text-white fw-bold" tabindex="2">
                        <i class="bi bi-eye"></i> Mostrar
                    </button>
                </div>
            </div>>

            @* Tarjeta oculta para mostrar datos antes de agregar *@
            <div id="panelPrevisualizacion" class="card border-info mb-4 shadow-sm" style="display: none;">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title text-info mb-1" id="previewNombre">Nombre del Jugador</h5>
                        <p class="card-text mb-0">
                            <strong>DNI:</strong> <span id="previewDni"></span> |
                            <strong>F. Nacimiento:</strong> <span id="previewNac"></span> |
                            <strong>Carnet:</strong> <span id="previewCarnet"></span>
                        </p>
                    </div>
                    <div>
                        @* Asignamos tabindex 3 al botón Agregar *@
                        <button type="button" id="btnAgregar" class="btn btn-success btn-lg shadow-sm" tabindex="3">
                            <i class="bi bi-plus-circle"></i> Agregar a Planilla
                        </button>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            @* --- FORMULARIO PRINCIPAL (LISTA DE JUGADORES) --- *@
            <form asp-action="GenerarPdf" method="post" target="_blank" id="formPlanilla">

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="NombreEquipo" class="form-label fw-bold">Nombre del Equipo</label>
                        <input asp-for="NombreEquipo" class="form-control" required placeholder="Ej: Los Pumas FC" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Categoria" class="form-label fw-bold">Categoría</label>
                        <input asp-for="Categoria" class="form-control" required placeholder="Ej: SUPER-60" />
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle border" id="tablaPlanilla">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 80px;">Nro</th>
                                <th>Nro Carnet</th>
                                <th>Apellido y Nombre</th>
                                <th>D.N.I.</th>
                                <th>Fecha Nacimiento</th>
                                <th style="width: 80px;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* Las filas se insertan vía JS *@
                        </tbody>
                    </table>
                </div>

                <div class="text-end mt-4">

    
    @* Botón existente: Sigue apuntando al asp-action="GenerarPdf" principal del formulario *@
    <button type="submit" class="btn btn-danger btn-lg shadow-sm">
        <i class="bi bi-file-pdf"></i> Generar PDF
    </button>
</div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/js/select2.full.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/css/select2.min.css" rel="stylesheet" />

    <script>
        // Variables globales para el control de la grilla
        var jugadorIndex = 0;
        var nroFila = 1;
        var jugadorSeleccionado = null;

        $(document).ready(function () {

        // 1. Inicializar Select2
        $('#JugadorSearch').select2({
        placeholder: "Ingrese DNI, Apellido o Nombre...",
        minimumInputLength: 3,
        ajax: {
        url: '@Url.Action("BuscarJugadores", "Planillas")',
        dataType: 'json',
        delay: 250,
        data: function (params) {
        return { term: params.term.trim() };
        },
        processResults: function (data) {
        return { results: data.results };
        },
        cache: true
        }
        });

        // EVNTO DE ENFOQUE AUTOMÁTICO: Al seleccionar un jugador con Enter o Click, el foco salta a "Mostrar"
        $('#JugadorSearch').on('select2:select', function (e) {
        setTimeout(function () {
        $('#btnMostrar').focus();
        }, 50);
        });

        // 2. Botón MOSTRAR
        $('#btnMostrar').click(function () {
        var data = $('#JugadorSearch').select2('data')[0];

        if (!data) {
        alert("Por favor, busque y seleccione un jugador primero.");
        $('#JugadorSearch').select2('open'); // Devuelve el foco si no hay selección
        return;
        }

        jugadorSeleccionado = data; // Guardamos en memoria

        // Llenamos el panel de previsualización
        $('#previewNombre').text(data.apellidoYNombre);
        $('#previewDni').text(data.dni);
        $('#previewNac').text(data.fechaNacimiento);
        $('#previewCarnet').text(data.nroCarnet);

        // Mostramos el panel y pasamos el FOCO al botón "Agregar" apenas termina la animación
        $('#panelPrevisualizacion').slideDown(function () {
        $('#btnAgregar').focus();
        });
        });

        // 3. Botón AGREGAR
        $('#btnAgregar').click(function () {
        if (!jugadorSeleccionado) return;

        // Evitar duplicados
        if ($('#tablaPlanilla tbody tr[data-dni="' + jugadorSeleccionado.dni + '"]').length > 0) {
        alert('Este jugador ya está en la planilla.');
        $('#JugadorSearch').select2('open'); // Devuelve el foco para buscar otro
        return;
        }

        var newRow = `
        <tr data-dni="${jugadorSeleccionado.dni}">
        <td class="fw-bold text-center">
        ${nroFila}
        <input type="hidden" name="Jugadores[${jugadorIndex}].IdJugador" value="${jugadorSeleccionado.id}" />
        <input type="hidden" name="Jugadores[${jugadorIndex}].Nro" value="${nroFila}" />
        <input type="hidden" name="Jugadores[${jugadorIndex}].NroCarnet" value="${jugadorSeleccionado.nroCarnet}" />
        <input type="hidden" name="Jugadores[${jugadorIndex}].ApellidoYNombre" value="${jugadorSeleccionado.apellidoYNombre}" />
        <input type="hidden" name="Jugadores[${jugadorIndex}].Dni" value="${jugadorSeleccionado.dni}" />
        <input type="hidden" name="Jugadores[${jugadorIndex}].FechaNacimiento" value="${jugadorSeleccionado.fechaNacimiento}" />
        </td>
        <td>${jugadorSeleccionado.nroCarnet}</td>
        <td>${jugadorSeleccionado.apellidoYNombre}</td>
        <td>${jugadorSeleccionado.dni}</td>
        <td>${jugadorSeleccionado.fechaNacimiento}</td>
        <td>
        <button type="button" class="btn btn-sm btn-outline-danger btn-remove"><i class="bi bi-trash"></i></button>
        </td>
        </tr>`;

        $('#tablaPlanilla tbody').append(newRow);
        jugadorIndex++;
        nroFila++;

        // Limpiar la selección
        $('#JugadorSearch').val(null).trigger('change');
        $('#panelPrevisualizacion').slideUp();
        jugadorSeleccionado = null;

        // LAZO DE RETORNO AL BUSCADOR: Reabre el Select2 automáticamente para la siguiente carga
        setTimeout(function () {
        $('#JugadorSearch').select2('open');
        }, 100);
        });

        // 4. Botón QUITAR (y reindexar)
        $('#tablaPlanilla').on('click', '.btn-remove', function () {
        $(this).closest('tr').remove();
        reIndexTable();
        });

        // Función vital para el binding de listas en MVC
        function reIndexTable() {
        nroFila = 1;
        $('#tablaPlanilla tbody tr').each(function (index) {
        // Actualizar el número visual de la fila
        $(this).find('td:first').contents().filter(function () {
        return this.nodeType === 3; // Selecciona solo el texto (no los inputs)
        }).replaceWith(nroFila + ' ');

        // Actualizar los índices de los name attributes
        $(this).find('input').each(function () {
        var name = $(this).attr('name');
        if (name) {
        $(this).attr('name', name.replace(/\[\d+\]/g, '[' + index + ']'));
        }
        });

        // Actualizar el valor del input Nro
        $(this).find('input[name$=".Nro"]').val(nroFila);

        nroFila++;
        });
        jugadorIndex = $('#tablaPlanilla tbody tr').length;
        }

        // Inicializar el foco abriendo el buscador al cargar la página por primera vez
        setTimeout(function () {
        $('#JugadorSearch').select2('open');
        }, 200);
        });
    </script>
}